NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_POOL_FACTORY=0x0000000000000000000000000000000000000000

# Email auth via Clerk (free tier: registration, email verification,
# password reset). Get keys at https://dashboard.clerk.com, then add to
# web/.env.local and restart the server. Without keys the app runs wallet-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
