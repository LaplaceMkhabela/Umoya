NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_POOL_FACTORY=0x0000000000000000000000000000000000000000

# Email auth: custom built-in service (no third party).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-64-hex-chars
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: real SMTP for auth emails. Without it, dev uses a disposable
# Ethereal inbox and the API returns a preview link.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Umoya <no-reply@umoya.example>"
# Auth DB path (default web/.data/umoya.db, gitignored)
# AUTH_DB_PATH=
